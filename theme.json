{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base (background)"
				},
				{
					"slug": "contrast",
					"color": "#111111",
					"name": "Contrast (text)"
				},
				{
					"slug": "primary",
					"color": "#1e40af",
					"name": "Primary (accent)"
				},
				{
					"slug": "secondary",
					"color": "#f4f4f4",
					"name": "Secondary (light background)"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', sans-serif",
					"slug": "system-sans",
					"name": "System Sans"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2.5rem",
					"name": "Extra Large"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "small",
					"size": "1rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "2rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "4rem",
					"name": "Large"
				}
			],
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)"
		}
	}
}